{
  "compilerOptions": {
    /* 🚩 1. กำหนดทางเข้าและทางออกของไฟล์ */
    "rootDir": "./src",        // บอก TS ว่าโค้ดอยู่ที่ไหน
    "outDir": "./dist",       // บอก TS ว่าคอมไพล์เสร็จให้เอาไฟล์ไปไว้ที่นี่

    /* 🚩 2. การตั้งค่าโมดูล (แนะนำให้ใช้ค่านี้สำหรับ Node.js ปัจจุบัน) */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    
    /* 🚩 3. Library และ Types ที่จำเป็น */
    "lib": ["ESNext"],
    "types": ["node"],        // สำคัญ: เพื่อให้ใช้ __dirname หรือ process ได้

    /* อื่นๆ คงไว้ตามเดิม */
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true   // เพิ่มตัวนี้เพื่อให้ Import library บางตัวได้ง่ายขึ้น
  },
  "include": ["src/**/*"],    // รวมเฉพาะไฟล์ใน src
  "exclude": ["node_modules", "**/*.test.ts"] // ไม่เอา node_modules มารวม
